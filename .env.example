# TTS (default: edge via policy / DUP_TTS_PROVIDER)
# DUP_TTS_PROVIDER=edge
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# Stock visuals (optional; synthetic used when unset)
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# DUP_ASSETS_DIR=./assets

# Optional LLM script writer
# OPENAI_API_KEY=
# DUP_LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# YouTube Data API (never commit real secrets)
# YOUTUBE_CLIENT_SECRETS=./client_secrets.json
# YOUTUBE_TOKEN=./token.json

# Instagram Graph (Reels) — needs public HTTPS video_url at publish time
# IG_USER_ID=
# IG_ACCESS_TOKEN=
